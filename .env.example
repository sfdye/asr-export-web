# server port (dev uses 3001; vite proxies /api to it)
PORT=3001

# where zips + the dev cookie key live (gitignored). prod: /var/lib/asr-export
DATA_DIR=.data

# 32-byte base64 key sealing the Habitap session cookie. generate:
#   openssl rand -base64 32
# if unset in dev, one is auto-generated into DATA_DIR/cookie.key
COOKIE_KEY=

# 1 = serve fixture data instead of calling Habitap (no real credentials needed)
MOCK_HABITAP=
