# Reference copy of the production systemd unit — the live one is
# /etc/systemd/system/asr-export.service on the droplet; keep them in sync.
#
# ExecStop drains before stopping: deploy/drain.sh (run from this repo
# checkout on the droplet) polls /api/health until no export is queued or
# running, so restarts/reboots don't kill in-flight jobs. TimeoutStopSec
# must exceed the drain timeout. Restart=on-failure restarts crashes
# immediately without draining (nothing to drain — the job died with the
# process and is reported as interrupted on the next boot).

[Unit]
Description=ASR export web (Hono)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/asr-export-web
EnvironmentFile=/etc/asr-export/env
ExecStart=/usr/bin/node dist/server/index.js
ExecStop=/home/deploy/asr-export-web/deploy/drain.sh 1800
TimeoutStopSec=1900
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
